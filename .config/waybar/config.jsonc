{
    "layer": "top",
    "height": 10,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "pulseaudio", "clock#date"],
    // Modules configurations
    "clock": {
        "format": "{:%I:%M %p}"
    },
    "clock#date": {
        "format": "{:%a %b %d}"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by-number": true
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "ignored-sinks": ["Easy Effects Sink"]
    },

    "tray": {
        "spacing": 5
    }
}
